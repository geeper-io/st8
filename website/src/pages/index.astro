---
const year = new Date().getFullYear();

const features = [
    {
        title: "Versioned by default",
        description: "Every write creates an immutable, numbered revision. Nothing is ever overwritten — full history, always.",
        icon: `<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>`,
    },
    {
        title: "Instant rollbacks",
        description: "Roll back any namespace or branch to a previous revision or named checkpoint with a single command.",
        icon: `<polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/>`,
    },
    {
        title: "Branches for isolation",
        description: "Run canary deployments or A/B tests by writing different config to different branches. Switch at request time.",
        icon: `<line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>`,
    },
    {
        title: "Namespaces",
        description: "Flat, free-form partitioning. Use any convention that fits — payments/prod, platform-staging, tenant-42.",
        icon: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>`,
    },
    {
        title: "Go client",
        description: "Typed, context-aware client with atomic in-memory cache and background polling. Zero allocations on the hot path.",
        icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
    },
    {
        title: "Self-hosted, open source",
        description: "st8d is a single binary. Run it on any Linux machine — bare-metal, VM, or container. MIT licensed.",
        icon: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>`,
    },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="Lightweight versioned state store for dynamic configuration, feature flags, and A/B testing."/>
    <meta property="og:title" content="st8 — Versioned State Store"/>
    <meta property="og:description" content="Dynamic config that feels like git. Namespaces, branches, checkpoints, rollbacks."/>
    <title>st8 — Versioned State Store</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Inter", system-ui, sans-serif;
            background: #020617;
            color: #f1f5f9;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Nav ───────────────────────────────────────────── */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            height: 64px;
            border-bottom: 1px solid transparent;
            transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
        }

        nav.scrolled {
            background: rgba(2, 6, 23, 0.9);
            backdrop-filter: blur(12px);
            border-color: #1e293b;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .nav-back {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.8rem;
            color: #475569;
            text-decoration: none;
            transition: color 0.15s;
        }

        .nav-back:hover { color: #94a3b8; }

        .nav-sep {
            color: #1e293b;
            font-size: 1.2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-name {
            font-size: 0.95rem;
            font-weight: 600;
            color: #f8fafc;
        }

        .nav-links {
            display: none;
            gap: 2rem;
            align-items: center;
        }

        @media (min-width: 768px) {
            .nav-links { display: flex; }
        }

        .nav-links a {
            color: #64748b;
            text-decoration: none;
            font-size: 0.875rem;
            transition: color 0.15s;
        }

        .nav-links a:hover { color: #f1f5f9; }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.4rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.15s;
        }

        .btn-ghost {
            color: #64748b;
            border: 1px solid #1e293b;
        }

        .btn-ghost:hover {
            color: #f1f5f9;
            border-color: #334155;
        }

        .btn-primary {
            background: #22c55e;
            color: #052e16;
        }

        .btn-primary:hover { background: #16a34a; }

        /* ── Hero ──────────────────────────────────────────── */
        .hero {
            padding: 10rem 2rem 6rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(34, 197, 94, 0.10), transparent);
            pointer-events: none;
        }

        .hero-grid {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(#22c55e 1px, transparent 1px), linear-gradient(90deg, #22c55e 1px, transparent 1px);
            background-size: 64px 64px;
            opacity: 0.03;
            pointer-events: none;
        }

        .hero-inner {
            position: relative;
            max-width: 720px;
            margin: 0 auto;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #22c55e;
            border: 1px solid rgba(34, 197, 94, 0.25);
            background: rgba(34, 197, 94, 0.08);
            padding: 0.3rem 0.875rem;
            border-radius: 999px;
            margin-bottom: 2rem;
        }

        h1 {
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1.1;
            color: #f8fafc;
            margin-bottom: 1.5rem;
        }

        h1 em {
            font-style: normal;
            background: linear-gradient(135deg, #4ade80, #22c55e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            font-size: 1.15rem;
            color: #64748b;
            line-height: 1.7;
            max-width: 560px;
            margin: 0 auto 2.5rem;
        }

        .cta {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.65rem 1.5rem;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.15s;
        }

        .btn-cta-primary {
            background: #22c55e;
            color: #052e16;
        }

        .btn-cta-primary:hover {
            background: #16a34a;
            transform: translateY(-1px);
        }

        .btn-cta-outline {
            border: 1px solid #1e293b;
            color: #94a3b8;
        }

        .btn-cta-outline:hover {
            border-color: #334155;
            color: #f1f5f9;
        }

        /* ── Features ──────────────────────────────────────── */
        .features-section {
            padding: 5rem 2rem 6rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .section-header h2 {
            font-size: clamp(1.75rem, 4vw, 2.25rem);
            font-weight: 700;
            letter-spacing: -0.03em;
            color: #f8fafc;
            margin-bottom: 0.75rem;
        }

        .section-header p {
            font-size: 1rem;
            color: #475569;
            max-width: 480px;
            margin: 0 auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1px;
            background: #1e293b;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #1e293b;
        }

        .feature-card {
            background: #0f172a;
            padding: 1.75rem;
            transition: background 0.15s;
        }

        .feature-card:hover { background: #0d1525; }

        .feature-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(34, 197, 94, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
        }

        .feature-card h3 {
            font-size: 0.95rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 0.5rem;
            letter-spacing: -0.01em;
        }

        .feature-card p {
            font-size: 0.875rem;
            color: #475569;
            line-height: 1.65;
        }

        /* ── Terminal snippet ──────────────────────────────── */
        .terminal-section {
            padding: 0 2rem 6rem;
            max-width: 720px;
            margin: 0 auto;
        }

        .terminal {
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 14px;
            overflow: hidden;
        }

        .terminal-bar {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #1e293b;
            background: #0a1120;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .terminal-body {
            padding: 1.25rem 1.5rem;
            font-family: "JetBrains Mono", monospace;
            font-size: 0.825rem;
            line-height: 2;
        }

        .t-dim   { color: #334155; }
        .t-cmd   { color: #e2e8f0; }
        .t-comment { color: #475569; }
        .t-green { color: #34d399; }
        .t-yellow { color: #fbbf24; }
        .t-blue  { color: #60a5fa; }

        /* ── Footer ────────────────────────────────────────── */
        footer {
            border-top: 1px solid #1e293b;
            padding: 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        footer p {
            color: #334155;
            font-size: 0.8rem;
        }

        footer a {
            color: #475569;
            text-decoration: none;
            font-size: 0.8rem;
            transition: color 0.15s;
        }

        footer a:hover { color: #94a3b8; }
    </style>
</head>
<body>

<nav id="nav">
    <div class="nav-left">
        <a href="https://geeper.io" class="nav-back">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            geeper.io
        </a>
        <span class="nav-sep">/</span>
        <a href="/" class="logo">
            <div class="logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.75"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5"/>
                    <path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <span class="logo-name">st8</span>
        </a>
    </div>

    <div class="nav-links">
        <a href="/guides/introduction/">Docs</a>
        <a href="https://github.com/geeper-io/st8" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>

    <div class="nav-right">
        <a href="https://github.com/geeper-io/st8" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
        </a>
        <a href="/guides/quickstart/" class="btn btn-primary">Get started</a>
    </div>
</nav>

<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="hero-inner">
        <div class="eyebrow">
            <svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor">
                <circle cx="3" cy="3" r="3"/>
            </svg>
            Open source
        </div>
        <h1>Dynamic config<br/><em>that feels like git</em></h1>
        <p class="subtitle">
            Namespaces, branches, checkpoints, rollbacks.<br/>
            Deploy config changes without redeploying code.
        </p>
        <div class="cta">
            <a href="/guides/quickstart/" class="btn-cta btn-cta-primary">
                Get started
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </a>
            <a href="/guides/introduction/" class="btn-cta btn-cta-outline">Read the docs</a>
        </div>
    </div>
</section>

<section class="features-section">
    <div class="section-header">
        <h2>Config management done right</h2>
        <p>Everything you need to change application behavior at runtime — safely, with history.</p>
    </div>
    <div class="features-grid">
        {features.map((f) => (
            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round" set:html={f.icon}/>
                </div>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
            </div>
        ))}
    </div>
</section>

<section class="terminal-section">
    <div class="terminal">
        <div class="terminal-bar">
            <div class="dot" style="background:#ef4444"></div>
            <div class="dot" style="background:#f59e0b"></div>
            <div class="dot" style="background:#22c55e"></div>
        </div>
        <div class="terminal-body">
            <div><span class="t-comment"># Push config — no restart, no redeploy</span></div>
            <div><span class="t-dim">$</span> <span class="t-cmd">echo <span class="t-yellow">'&#123;"new_checkout":true&#125;'</span> &gt; feature_flags.json</span></div>
            <div><span class="t-dim">$</span> <span class="t-cmd">st8ctl <span class="t-blue">--local</span> apply <span class="t-blue">-f</span> feature_flags.json <span class="t-blue">--message</span> <span class="t-yellow">"enable new checkout"</span></span></div>
            <div><span class="t-green">✓</span> <span class="t-cmd">Revision 42 created</span></div>
            <div>&nbsp;</div>
            <div><span class="t-comment"># Tag a known-good state</span></div>
            <div><span class="t-dim">$</span> <span class="t-cmd">st8ctl <span class="t-blue">--local</span> checkpoint stable</span></div>
            <div><span class="t-green">✓</span> <span class="t-cmd">Checkpoint <span class="t-green">"stable"</span> → rev 42</span></div>
            <div>&nbsp;</div>
            <div><span class="t-comment"># Something went wrong — roll back instantly</span></div>
            <div><span class="t-dim">$</span> <span class="t-cmd">st8ctl <span class="t-blue">--local</span> rollback <span class="t-blue">--checkpoint</span> stable <span class="t-blue">--message</span> <span class="t-yellow">"revert: latency spike"</span></span></div>
            <div><span class="t-green">✓</span> <span class="t-cmd">Rolled back to rev 42 (rev 43 created)</span></div>
        </div>
    </div>
</section>

<footer>
    <div class="footer-left">
        <a href="https://geeper.io">geeper.io</a>
        <a href="https://github.com/geeper-io/st8" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/guides/introduction/">Docs</a>
    </div>
    <p>© {year} Geeper. Open source under the MIT License.</p>
</footer>

<script>
    const nav = document.getElementById("nav");
    window.addEventListener("scroll", () => {
        nav.classList.toggle("scrolled", window.scrollY > 10);
    });
</script>
</body>
</html>
